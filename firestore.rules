rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Returns the caller's role string from the campaign's members map,
    // or null if the user is not in the map.
    function getRole(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId))
               .data.members[request.auth.uid];
    }

    // True when the caller is authenticated via a non-anonymous provider (D-02).
    function isNotAnonymous() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    // True when the caller has the GLOBAL admin role (users/{uid}.role == "admin").
    // Global admins get full access to every campaign regardless of membership.
    // The exists() guard avoids erroring on users who have no registry doc yet.
    function isGlobalAdmin() {
      return isNotAnonymous()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // True when the caller has the GLOBAL gm role. Global masters are co-masters of
    // every campaign — they see, enter, create and manage any campaign, matching the
    // "GM sees all active campaigns" requirement. (A player-membership in a specific
    // campaign only affects the in-app UI role, not these DB permissions.)
    function isGlobalGM() {
      return isNotAnonymous()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "gm";
    }

    // Global staff: admin or gm — full access to every campaign.
    function isGlobalManager() {
      return isGlobalAdmin() || isGlobalGM();
    }

    // True when the caller is a recognised campaign member (any role) OR global staff.
    function isMember(campaignId) {
      return isGlobalManager()
          || (isNotAnonymous()
              && getRole(campaignId) in ["gm", "admin", "player", "demo"]);
    }

    // True when the caller holds a privileged campaign role OR is global staff.
    function isGMOrAdmin(campaignId) {
      return isGlobalManager()
          || (isNotAnonymous()
              && getRole(campaignId) in ["gm", "admin"]);
    }

    // True when the caller owns the given character (its ownerUid is theirs).
    function ownsChar(campaignId, charId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(charId))
               .data.ownerUid == request.auth.uid;
    }

    // True when an update touches only the listed keys (and nothing else).
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── Global user registry (users/{uid}) ──────────────────────────────────
    // Source of truth for a user's GLOBAL role (admin/gm/player). Created on
    // first login with role forced to "player" — nobody self-promotes. The first
    // admin is set by hand in the Firebase console; thereafter admins manage
    // roles in-app. A user reads/edits their own profile but never their own role.
    match /users/{uid} {
      allow read:   if isNotAnonymous() && (request.auth.uid == uid || isGlobalAdmin());
      allow create: if isNotAnonymous()
                    && request.auth.uid == uid
                    && request.resource.data.role == "player";
      allow update: if isGlobalAdmin()
                    || (isNotAnonymous()
                        && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);
      allow delete: if isGlobalAdmin();
    }

    // ── Campaign document ────────────────────────────────────────────────────

    match /campaigns/{campaignId} {
      // Read the campaign DOC via memberUids DIRECTLY — the exact field the
      // "my campaigns" query filters on (memberUids array-contains uid). Using the
      // members-map get() here (isMember) meant that if ANY matched campaign had a
      // members/memberUids mismatch, Firestore rejected the WHOLE list query and the
      // player saw zero campaigns. resource.data.memberUids is the candidate doc's
      // own array — no cross-doc get(), no mismatch, no silent list-wide denial.
      allow read:  if isGlobalManager()
                   || (isNotAnonymous()
                       && resource.data.memberUids != null
                       && request.auth.uid in resource.data.memberUids);

      // Create a brand-new campaign: the creator must list themselves as gm
      // (master) or admin in the new doc's members map, and appear in memberUids
      // (the array we query "my campaigns" by). getRole() can't be used here — the
      // campaign doc does not exist yet — so we validate request.resource.data.
      allow create: if isNotAnonymous()
                    && request.resource.data.members[request.auth.uid] in ["gm", "admin"]
                    && request.auth.uid in request.resource.data.memberUids;

      // Existing campaign: only gm/admin may edit or delete it.
      allow update: if isGMOrAdmin(campaignId);
      allow delete: if isGMOrAdmin(campaignId);

      // ── Characters ────────────────────────────────────────────────────────

      match /characters/{charId} {
        allow read: if isMember(campaignId);

        // Player may create only their own character (the chargen wizard).
        allow create: if isGMOrAdmin(campaignId)
                      || (isNotAnonymous()
                          && getRole(campaignId) == "player"
                          && request.resource.data.ownerUid == request.auth.uid);

        // Player may update only their OWN character, may not transfer ownerUid,
        // and — the anti-cheat core (B-50/D1) — may never INCREASE money or
        // experience, nor raise bennies. Decreases are allowed: buying spends
        // money, advancement debits XP, a future reroll spends a bennie. Every
        // economy CREDIT (sell proceeds, salary, GM grants) goes through the GM
        // path, which bypasses these constraints.
        allow update: if isGMOrAdmin(campaignId)
                      || (isNotAnonymous()
                          && getRole(campaignId) == "player"
                          && resource.data.ownerUid == request.auth.uid
                          && request.resource.data.ownerUid == request.auth.uid
                          && request.resource.data.money <= resource.data.money
                          && request.resource.data.experience <= resource.data.experience
                          && request.resource.data.bennies <= resource.data.bennies);

        // Only GM/admin may delete a character.
        allow delete: if isGMOrAdmin(campaignId);

        // GM-only private sub-document (gmNotes — D-04).
        match /private/{doc} {
          allow read, write: if isGMOrAdmin(campaignId);
        }

        // Advancement log entries — GM read/write.
        // Character owner may also create a chargen_created entry.
        match /log/{logId} {
          allow read:   if isGMOrAdmin(campaignId);
          allow write:  if isGMOrAdmin(campaignId);
          allow create: if isNotAnonymous()
                        && getRole(campaignId) == "player"
                        && request.resource.data.type == "chargen_created"
                        && get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(charId)).data.ownerUid == request.auth.uid;
        }
      }

      // ── Scenes (B-08) ─────────────────────────────────────────────────────

      match /scenes/{sceneId} {
        allow read:  if isMember(campaignId);
        allow write: if isGMOrAdmin(campaignId);
      }

      // ── Campaign config (B-05 — advancement cost document lives here) ─────

      match /config/{configId} {
        allow read:  if isMember(campaignId);
        allow write: if isGMOrAdmin(campaignId);
      }

      // ── Journal streams (B-13) ────────────────────────────────────────────
      // Three streams: campaign (public), worldNews (public), gmPrivate (GM).
      // Exact collection structure finalised in B-13; path uses the stream
      // name as the first wildcard segment.
      //
      // IMPORTANT: Firestore grants access if ANY matching rule allows it, so
      // gmPrivate must NOT have a separate broader rule that would bypass it.
      // The single rule below encodes both cases in one expression.

      match /journal/{stream}/pages/{pageId} {
        allow read: if (stream != "gmPrivate" && isMember(campaignId))
                    || isGMOrAdmin(campaignId);
        allow write: if isGMOrAdmin(campaignId);
      }

      // ── GM presence document (D-21 — gmModeActive ephemeral doc) ──────────

      match /presence/{presenceId} {
        allow read:  if isMember(campaignId);
        allow write: if isGMOrAdmin(campaignId);
      }

      // ── Roll log (B-18) ───────────────────────────────────────────────────

      match /rolls/{rollId} {
        allow read:   if isMember(campaignId);
        // Players may only log rolls for a character they own; GM rolls for anyone.
        allow create: if isGMOrAdmin(campaignId)
                      || (isMember(campaignId)
                          && get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(request.resource.data.characterId)).data.ownerUid == request.auth.uid);
        allow update, delete: if isGMOrAdmin(campaignId);
      }

      // ── Organizations / Contacts (FEAT-14, IMP-17) ───────────────────────
      // GM-curated. Players read only cards flagged visibleToPlayers.
      // IMP-17: a member may link/unlink themselves to a VISIBLE org — the
      // bidirectional mirror writes org.actorRefs. That is the ONLY field a
      // non-GM may touch, and only while the card stays visible. Residual
      // griefing (editing another char's actorRefs entry on a visible org) is
      // accepted — no economy impact; the authoritative level also lives on the
      // player's own character.refs.contacts (guarded by the character rule).
      match /organizations/{orgId} {
        allow read:   if isGMOrAdmin(campaignId)
                      || (isMember(campaignId) && resource.data.visibleToPlayers == true);
        allow create, delete: if isGMOrAdmin(campaignId);
        allow update: if isGMOrAdmin(campaignId)
                      || (isMember(campaignId)
                          && resource.data.visibleToPlayers == true
                          && request.resource.data.visibleToPlayers == true
                          && changedOnly(['actorRefs']));
      }

      // ── Library (FEAT-04 reshaped) — GM reference: NPCs/curators/faculties/
      //    companions/daemons. Same visibility model as organizations:
      //    players read only cards flagged visibleToPlayers; writes GM-only.
      match /library/{entryId} {
        allow read:  if isGMOrAdmin(campaignId)
                     || (isMember(campaignId) && resource.data.visibleToPlayers == true);
        allow write: if isGMOrAdmin(campaignId);
      }

      // ── Items collection (B-14 — rules to be extended there) ─────────────
      // Base read/write rule; B-14 will add the player-purchase exception for
      // shop transfers (D-22 no-approval path).

      match /items/{itemId} {
        allow read:  if isMember(campaignId);
        allow write: if isGMOrAdmin(campaignId);
        // Item owner may toggle only activation/equipped state on their own item
        // (used by the item roller). No other fields may change via this path.
        allow update: if isMember(campaignId)
                      && resource.data.ownerCharacterId != null
                      && ownsChar(campaignId, resource.data.ownerCharacterId)
                      && changedOnly(["active", "equipped"]);
        // Shop BUY (unique, D-22): claim an unowned catalog item for your own
        // character — sets ownerCharacterId from null and changes nothing else.
        allow update: if isMember(campaignId)
                      && resource.data.ownerCharacterId == null
                      && changedOnly(["ownerCharacterId"])
                      && request.resource.data.ownerCharacterId != null
                      && ownsChar(campaignId, request.resource.data.ownerCharacterId);
        // Shop SELL (D-22): release your own item back to the catalog (unowned).
        allow update: if isMember(campaignId)
                      && resource.data.ownerCharacterId != null
                      && ownsChar(campaignId, resource.data.ownerCharacterId)
                      && changedOnly(["ownerCharacterId"])
                      && request.resource.data.ownerCharacterId == null;
        // Shop BUY (stackable, D-22): create a purchased item for your own character.
        allow create: if isMember(campaignId)
                      && request.resource.data.ownerCharacterId != null
                      && ownsChar(campaignId, request.resource.data.ownerCharacterId);
      }

      // ── Shops (B-19 / FEAT-17, revised B-50/D1) ───────────────────────────
      // Shop documents (stock, prices, journals) are GM-only. Players can no
      // longer write the shop doc — the previous member-update on stock/journals
      // let a player rewrite prices, restock, or forge journal entries (Firestore
      // rules cannot validate array contents, so that path was unsafe).
      //
      // SELF-SERVICE BUY still works without a GM and without writing the shop:
      //   - unique  → claim the catalog item (items rule: ownerCharacterId null→self)
      //               + decrease own money (character rule). Double-buy is blocked
      //               by the item-ownership precondition, not the shop array.
      //   - stackable → create the purchased item for self (items rule) + decrease
      //               own money. (Residual free-tier gap: stackable quantity is not
      //               decremented by the player, and item creation is not bound to
      //               payment. Only Cloud Functions could close this fully.)
      // SELLING is GM-approved via sellRequests below.

      match /shops/{shopId} {
        allow read:  if isMember(campaignId);
        allow write: if isGMOrAdmin(campaignId);
      }

      // ── Sell requests (B-50/D1) ───────────────────────────────────────────
      // A player asks to sell an owned item; this write changes no money or stock.
      // The GM reviews, sets the final price, and commits the payout (GM path on
      // the item + character + shop journal), then deletes the request.
      match /sellRequests/{reqId} {
        allow read:   if isGMOrAdmin(campaignId)
                      || (isMember(campaignId) && resource.data.ownerUid == request.auth.uid);
        allow create: if isNotAnonymous()
                      && getRole(campaignId) == "player"
                      && request.resource.data.ownerUid == request.auth.uid
                      && ownsChar(campaignId, request.resource.data.charId);
        allow delete: if isGMOrAdmin(campaignId)
                      || (isMember(campaignId) && resource.data.ownerUid == request.auth.uid);
        allow update: if isGMOrAdmin(campaignId);
      }

      // ── Chargen requests (FEAT-10) ────────────────────────────────────────
      // Written by the player when they finish the character creation wizard.
      // GM reads them to handle special-ability and background requests.

      match /chargen_requests/{reqId} {
        allow read:   if isGMOrAdmin(campaignId);
        allow create: if isMember(campaignId);
      }

      // ── Status definitions (B-27) ─────────────────────────────────────────
      // All members can read the status library; only GM/admin can write.

      match /statuses/{statusId} {
        allow read:  if isMember(campaignId);
        allow write: if isGMOrAdmin(campaignId);
      }
    }
  }
}
