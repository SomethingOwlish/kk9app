rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Portrait uploads: portraits/{campaignId}/{charId}.{ext}
    // Any authenticated non-anonymous user may write an image ≤ 5 MB.
    // GMs and players can both upload portraits (wizard and EditCard).
    match /portraits/{campaignId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != "anonymous";

      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != "anonymous"
                   && request.resource.contentType.matches("image/.*")
                   && request.resource.size <= 5 * 1024 * 1024;
    }
  }
}
